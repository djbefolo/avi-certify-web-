rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && isEmailVerified();
    }

    function isValidDocumentFileName(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+-[a-z0-9][a-z0-9-]{0,71}\\.(pdf|jpg|png)$');
    }

    function hasMatchingDocumentExtension(fileName) {
      return (request.resource.contentType == 'application/pdf'
          && fileName.matches('.*\\.pdf$'))
        || (request.resource.contentType == 'image/jpeg'
          && fileName.matches('.*\\.jpg$'))
        || (request.resource.contentType == 'image/png'
          && fileName.matches('.*\\.png$'));
    }

    match /users/{userId}/documents/{fileName} {
      allow read: if isVerifiedOwner(userId);
      allow create: if isVerifiedOwner(userId)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png)$')
        && isValidDocumentFileName(fileName)
        && hasMatchingDocumentExtension(fileName);
      allow update: if false;
      allow delete: if false;
    }
  }
}
