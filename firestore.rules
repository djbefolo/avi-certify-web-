rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && isEmailVerified();
    }

    function hasAdminClaim() {
      return isSignedIn()
        && (request.auth.token.admin == true || request.auth.token.role == "admin");
    }

    function userUpdateFields() {
      return [
        "firstName",
        "lastName",
        "fullName",
        "phone",
        "phoneWhatsApp",
        "birthDate",
        "birthCountry",
        "dateOfBirth",
        "placeOfBirth",
        "nationality",
        "countryOfResidence",
        "residenceCountry",
        "destinationCountry",
        "destinationCity",
        "targetSchoolName",
        "admissionStatus",
        "admissionDocumentStatus",
        "intendedProgram",
        "intendedAcademicYear",
        "intendedArrivalDate",
        "expectedStayDuration",
        "financialNeedType",
        "requestedAviAmount",
        "needsFinancing",
        "selectedService",
        "housingNeed",
        "preferredHousingCity",
        "previousVisaRefusal",
        "previousVisaRefusalCountry",
        "emergencyContactName",
        "emergencyContactPhone",
        "serviceInterest",
        "profileSource",
        "lastIntent",
        "updatedAt",
        "profileUpdatedAt"
      ];
    }

    function documentFields() {
      return [
        "ownerId",
        "documentType",
        "status",
        "originalFileName",
        "safeFileName",
        "contentType",
        "size",
        "storagePath",
        "createdAt",
        "updatedAt"
      ];
    }

    function hasRequiredDocumentFields() {
      return request.resource.data.keys().hasOnly(documentFields())
        && request.resource.data.keys().hasAll(documentFields());
    }

    function hasValidDocumentMetadata() {
      return request.resource.data.ownerId is string
        && request.resource.data.documentType is string
        && request.resource.data.status is string
        && request.resource.data.originalFileName is string
        && request.resource.data.safeFileName is string
        && request.resource.data.contentType is string
        && request.resource.data.size is number
        && request.resource.data.storagePath is string;
    }

    function isAllowedDocumentType(documentType) {
      return documentType in [
        "passport",
        "admission_letter",
        "payment_proof",
        "identity_document",
        "accommodation_certificate",
        "bank_document",
        "other"
      ];
    }

    function isAllowedDocumentContentType(contentType) {
      return contentType in [
        "application/pdf",
        "image/jpeg",
        "image/png"
      ];
    }

    function isValidDocumentStoragePath(documentId) {
      return request.resource.data.storagePath.matches(
        "^users/" + request.auth.uid + "/documents/" + documentId + "-[^/]+$"
      );
    }

    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if false;
      allow update: if isVerifiedOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.profileSource == "user_profile"
        && request.resource.data.lastIntent == "profile_update"
        && request.resource.data.serviceInterest == request.resource.data.selectedService
        && request.resource.data.updatedAt == request.time
        && request.resource.data.profileUpdatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userUpdateFields());
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow read: if isVerifiedOwner(resource.data.userId);
      allow create, update: if false;
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow read: if isVerifiedOwner(resource.data.ownerId);
      allow create: if isEmailVerified()
        && hasRequiredDocumentFields()
        && hasValidDocumentMetadata()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "uploaded"
        && isAllowedDocumentType(request.resource.data.documentType)
        && isAllowedDocumentContentType(request.resource.data.contentType)
        && request.resource.data.size > 0
        && request.resource.data.size <= 5 * 1024 * 1024
        && isValidDocumentStoragePath(documentId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isVerifiedOwner(resource.data.ownerId);
      allow create, update, delete: if false;
    }

    // Fintech financial admin collections are server-owned.
    // Firebase Admin SDK bypasses rules; browser/client SDK access is denied even
    // for future admin-claim users until a dedicated hardened admin client policy exists.
    match /financial_products/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /fx_rates/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /pricing_rules/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /risk_surcharge_rules/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /financing_simulations/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /financing_quotes/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /quote_line_items/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /client_prefinancing_reports/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }

    match /admin_financial_audit_events/{document=**} {
      allow read, write: if false && hasAdminClaim();
    }
  }
}
