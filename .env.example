# Public browser-exposed values. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Google Search Console site-ownership verification code (from the
# GSC "HTML tag" verification method). Leave empty until you add the real
# property in Search Console — the meta tag is omitted when this is unset.
NEXT_PUBLIC_GSC_VERIFICATION=

# Server-only secrets and operational email config.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep escaped newlines as \n if the private key is stored on one line.
FIREBASE_PRIVATE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
# Optional fallback only. The primary signature source is private Firebase Storage at
# internal-assets/certificates/president-signature-stamp.png.
HOUSING_CERTIFICATE_SIGNATURE_STAMP_DATA_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
